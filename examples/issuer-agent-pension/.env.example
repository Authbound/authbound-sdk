# Verification secret API key (sk_test_* or sk_live_*)
AUTHBOUND_SECRET_KEY=sk_test_your_key_here

# Publishable key — required for browser-safe verification status polling
AUTHBOUND_PUBLISHABLE_KEY=pk_test_your_key_here

# Issuance uses a separate client. Both settings are required for /offer.
# Use a key authorized for issuer reads and writes in the selected environment.
AUTHBOUND_ISSUANCE_SECRET_KEY=sk_test_your_issuance_key_here
# Set this to the API base URL of your issuance environment.
AUTHBOUND_ISSUANCE_API_URL=

# Optional: point verification at local gateway or internal staging instead of production API
# AUTHBOUND_API_URL=http://127.0.0.1:3001
# AUTHBOUND_API_URL=https://api.example.com

# Optional
# PORT=3333
# AUTHBOUND_DEBUG=true
