# One secret API key for both issuance and verification (sk_test_* or sk_live_*)
# Authorize issuer reads/writes and verification reads/writes.
AUTHBOUND_SECRET_KEY=sk_test_your_key_here

# Publishable key — required for browser-safe verification status polling
AUTHBOUND_PUBLISHABLE_KEY=pk_test_your_key_here

# Optional: use Authbound staging for both issuance and verification.
# Uncomment this URL and configure secret and publishable keys for staging.
# Leave it unset to use the SDK default API URL.
# AUTHBOUND_API_URL=https://staging-api.authbound.io

# Optional
# PORT=3333
# AUTHBOUND_DEBUG=true
